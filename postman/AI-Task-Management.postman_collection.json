{
  "info": {
    "_postman_id": "b4684eca-fe6e-5628-a9da-606c899c897b",
    "name": "AI-Powered Task Management System",
    "description": "Covers registration, login, regular-user and admin task APIs, authorization failures, validation errors and the AI endpoints. Run the folders in order with the Collection Runner. Set baseUrl and the seeded credentials in the collection variables if they differ. Tokens and task IDs are stored automatically by the login and create requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "0. System",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "auth": {
              "type": "noauth"
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Service reports ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        }
      ],
      "description": ""
    },
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register a new user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "auth": {
              "type": "noauth"
            },
            "description": "Creates a regular user. The role cannot be chosen by the client.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Tester\",\n  \"email\": \"postman-{{$randomUUID}}@example.com\",\n  \"password\": \"Postman-Pass-123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Role defaults to user and password is not returned\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.role).to.eql(\"user\");",
                  "    pm.expect(body).to.not.have.property(\"password\");",
                  "    pm.expect(body).to.not.have.property(\"password_hash\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register with an existing email (conflict)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "auth": {
              "type": "noauth"
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Duplicate\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"Whatever-123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Error code is conflict\", () => pm.expect(pm.response.json().error.code).to.eql(\"conflict\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register with role=admin is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "auth": {
              "type": "noauth"
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Escalation\",\n  \"email\": \"escalate-{{$randomUUID}}@example.com\",\n  \"password\": \"Whatever-123\",\n  \"role\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"Validation error returned\", () => pm.expect(pm.response.json().error.code).to.eql(\"validation_error\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as regular user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "description": "Stores the JWT in the userToken collection variable.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response contains a JWT access token\", () => {",
                  "    pm.expect(pm.response.json().access_token).to.be.a(\"string\").and.not.be.empty;",
                  "});",
                  "pm.collectionVariables.set(\"userToken\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
