          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response contains a JWT access token\", () => {",
                  "    pm.expect(pm.response.json().access_token).to.be.a(\"string\").and.not.be.empty;",
                  "});",
                  "pm.collectionVariables.set(\"adminToken\", pm.response.json().access_token);"
                ]
              }
            }
